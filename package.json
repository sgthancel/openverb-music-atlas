{
  "name": "@openverb/music-atlas",
  "version": "0.2.0",
  "description": "The official SDK for Open Music Atlas: the World Music Atlas's places and the Solar System's bodies, their songs, editions, GeoJSON and embeddable players, with OpenVerb verbs for AI agents.",
  "keywords": [
    "openverb",
    "open-music-atlas",
    "world-music-atlas",
    "music",
    "geography",
    "gis",
    "geojson",
    "maps",
    "leaflet",
    "maplibre",
    "ai",
    "agent",
    "verbs",
    "solar-system",
    "astronomy",
    "planets",
    "space"
  ],
  "author": "Roman Hancel <roman@romanhancel.com>",
  "homepage": "https://openmusicatlas.org/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgthancel/openverb-music-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/sgthancel/openverb-music-atlas/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./openverb": {
      "types": "./dist/openverb.d.ts",
      "import": "./dist/openverb.js"
    },
    "./openverb.music_atlas.json": "./openverb.music_atlas.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "openverb.music_atlas.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/client.test.mjs test/cjs.test.cjs test/openverb.test.mjs",
    "test:live": "npm run build && node --test test/live.test.mjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "openverb": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "openverb": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22",
    "openverb": "^0.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
